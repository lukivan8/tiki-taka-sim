# Remote developer mode: local simulation, prompts and geometry; server-side Nova.
AFC_NOVA_GATEWAY_URL=https://afc.ivanlukov.com/api/inference
AFC_GATEWAY_TOKEN=replace-with-your-personal-invite-token
AFC_GATEWAY_TIMEOUT_SECONDS=90

# Set these only if the hostname is additionally protected by Cloudflare Access.
# CF_ACCESS_CLIENT_ID=
# CF_ACCESS_CLIENT_SECRET=
